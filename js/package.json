{
  "name": "@fitzdoud/valun",
  "version": "0.6.0",
  "description": "Zero-dependency JavaScript/TypeScript client for the Valun agent credit network (valun-deal/1): local secp256k1 key, Basis Schnorr signatures, independent checks before every signature. Experimental pilot: synthetic units, nothing settled.",
  "license": "MIT",
  "author": "Fitz Doud",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./file-store": {
      "types": "./src/file-store.d.ts",
      "default": "./src/file-store.js"
    },
    "./dns": {
      "types": "./src/dns.d.ts",
      "default": "./src/dns.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "valun",
    "agents",
    "agent-to-agent",
    "credit",
    "basis",
    "schnorr",
    "secp256k1",
    "blake2b"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzss/valun-open.git",
    "directory": "js"
  },
  "homepage": "https://github.com/fitzss/valun-open/tree/main/js",
  "publishConfig": {
    "access": "public"
  }
}
